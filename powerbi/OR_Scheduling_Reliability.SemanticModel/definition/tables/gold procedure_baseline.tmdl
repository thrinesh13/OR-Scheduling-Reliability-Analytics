		sourceColumn: mean_duration_min

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column stdev_duration_min
		dataType: double
		lineageTag: c865e304-8119-44fc-a08b-8724abe82acf
