	column or_hours_consumed
		dataType: double
		lineageTag: a07de0ee-d417-41a0-8a66-e741d97a21cc
		summarizeBy: none
		sourceColumn: or_hours_consumed

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column mae_min
		dataType: double
		lineageTag: 957f13ad-4efe-4e06-8068-d07425774e25
		summarizeBy: none
		sourceColumn: mae_min

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column median_abs_error_min
		dataType: double
		lineageTag: 710aac82-36f1-4fb5-9f78-e1d8f40cd112
		summarizeBy: none
		sourceColumn: median_abs_error_min

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column pct_outside_30
		dataType: double
		lineageTag: d8b0f250-a805-4d73-8463-9c963aff2c15
		summarizeBy: none
		sourceColumn: pct_outside_30

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column pct_overrun_30
		dataType: double
		lineageTag: 1be8227e-f399-45e5-92fe-164c28af88e5
		summarizeBy: none
		sourceColumn: pct_overrun_30

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column pct_early_30
		dataType: double
		lineageTag: 5f4d892e-c95d-4ee7-8e45-bc23d4037f5c
		summarizeBy: none
		sourceColumn: pct_early_30

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column total_deviation_min
		dataType: double
		lineageTag: 2aa609f3-7152-4302-ae21-3419ef60b7df
		summarizeBy: none
		sourceColumn: total_deviation_min

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Two-value classification, calculated per row so it can be used as chart legend/color: procedures at or above the cohort median on both annualized deviation and % outside ±30, versus everything else.
	column 'Review Flag' =
			SWITCH(
			    TRUE(),
			    DIVIDE('gold procedure_baseline'[total_deviation_min], 5.75) >= [Cohort Median – Annualized Deviation]
			        && DIVIDE('gold procedure_baseline'[pct_outside_30], 100) >= [Cohort Median – % Outside ±30],
			    "Higher exposure / lower reliability",
			    "Other review contexts"
			)
		lineageTag: f0d3a5aa-2f6e-4a1a-9e7e-6e6b7c1e9a11
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Action-oriented classification of each procedure against the cohort median on both axes (exposure = annualized deviation, reliability = % outside ±30 min), calculated per row. Each label is paired with a short plain-language description after the slash. "Prioritize review" = at/above median on both dimensions, the highest-priority combination. Relative to this 418-procedure cohort, not a clinical or performance target.
	column 'Review Context' =
			SWITCH(
			    TRUE(),
			    DIVIDE('gold procedure_baseline'[total_deviation_min], 5.75) >= [Cohort Median – Annualized Deviation]
			        && DIVIDE('gold procedure_baseline'[pct_outside_30], 100) >= [Cohort Median – % Outside ±30],
			    "Prioritize review / high exposure, unreliable",
			    DIVIDE('gold procedure_baseline'[total_deviation_min], 5.75) >= [Cohort Median – Annualized Deviation],
			    "Review exposure / high exposure, reliable",
			    DIVIDE('gold procedure_baseline'[pct_outside_30], 100) >= [Cohort Median – % Outside ±30],
			    "Review variability / low exposure, unreliable",
			    "Monitor / low exposure, reliable"
			)
		lineageTag: 5b87c857-dd2b-41eb-9b1e-dd40b638f79c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'gold procedure_baseline' = m
		mode: import
		source =
				let
				    Source = Sql.Database("opu254nl33zulpqake74kewhge-2avfjyg5adkebmenf26ohq4cmq.datawarehouse.fabric.microsoft.com", "moverdata"),
				    gold_procedure_baseline = Source{[Schema="gold",Item="procedure_baseline"]}[Data]
				in
				    gold_procedure_baseline

	annotation PBI_ResultType = Table

