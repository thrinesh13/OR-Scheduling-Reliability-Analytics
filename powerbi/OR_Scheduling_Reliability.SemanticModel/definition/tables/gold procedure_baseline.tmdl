table 'gold procedure_baseline'
	lineageTag: 9013e122-7063-4fce-accf-4964ce8bec3a

	/// Per-procedure annualized absolute deviation, in minutes per year, on the same 5.75-year annualization basis as the portfolio figure. Evaluates one procedure at a time when Procedure is on the visual (X axis of the reliability-vs-exposure quadrant).
	measure 'Annualized Deviation (Procedure)' = DIVIDE(SUM('gold procedure_baseline'[total_deviation_min]), 5.75)
		formatString: #,##0
		displayFolder: Procedure Scorecard
		lineageTag: cb4422ce-2a85-424a-959d-c7aa7a21f06d

	/// Per-procedure share of cases finishing more than 30 minutes from baseline, in either direction — same definition as the portfolio % Outside ±30 Min measure, evaluated per procedure (Y axis of the reliability-vs-exposure quadrant).
	measure '% Outside ±30 Min (Procedure)' = DIVIDE(AVERAGE('gold procedure_baseline'[pct_outside_30]), 100)
		formatString: 0.0%
		displayFolder: Procedure Scorecard
		lineageTag: ea232398-7f42-4b0c-8418-4510911f12f6

	/// Unweighted median of annualized deviation across all 418 procedures in the cohort (each procedure counted once, regardless of case volume). Uses ALL() so it stays fixed regardless of any procedure selection — a relative reference line, not a target.
	measure 'Cohort Median – Annualized Deviation' = MEDIANX(ALL('gold procedure_baseline'), DIVIDE('gold procedure_baseline'[total_deviation_min], 5.75))
		formatString: #,##0
		displayFolder: Procedure Scorecard
		lineageTag: c908d165-65a1-4938-a4b9-3130b4e08a89

	/// Unweighted median of % Outside ±30 Min across all 418 procedures in the cohort. Uses ALL() so it stays fixed regardless of any procedure selection — a relative reference line, not a target.
	measure 'Cohort Median – % Outside ±30' = DIVIDE(MEDIANX(ALL('gold procedure_baseline'), 'gold procedure_baseline'[pct_outside_30]), 100)
		formatString: 0.0%
		displayFolder: Procedure Scorecard
		lineageTag: 7f7af978-7817-464f-93c4-d9a593c980fb

	/// Case count for the procedure in context. Used as the table's Cases column and the quadrant's bubble size, so both read from the same measure.
	measure 'Cases (Procedure)' = SUM('gold procedure_baseline'[case_count])
		formatString: #,##0
		displayFolder: Procedure Scorecard
		lineageTag: 0c8ca84e-4a26-49e6-8bb9-6eaa598e4cfd

	column Procedure
		dataType: string
		lineageTag: b6b38bc6-c17e-47c7-b618-1cc1254eeaa6
		summarizeBy: none
		sourceColumn: procedure_nm

		annotation SummarizationSetBy = Automatic

	column case_count
		dataType: int64
		formatString: 0
		lineageTag: 66df36d1-ab2a-4eb0-87aa-ca04580ce46e
		summarizeBy: none
		sourceColumn: case_count

		annotation SummarizationSetBy = Automatic

	column 'Historical Benchmark (min)'
		dataType: double
		formatString: #,##0
		lineageTag: 4b0b3434-31ea-4fb3-b699-05d2d13eae5c
		summarizeBy: none
		sourceColumn: expected_duration_min

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column mean_duration_min
		dataType: double
		lineageTag: 24cb9eee-8617-4b69-b307-8820cc382452
