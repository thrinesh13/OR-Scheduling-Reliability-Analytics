table 'gold fact_cases'
	lineageTag: d3eb5008-728d-4b37-9759-8f2f412a3eae

	/// Count of case-level records in the analytical cohort (cases with a usable OR duration, joined to a procedure baseline with at least 30 qualifying cases).
	measure 'Total Cases' = COUNTROWS('gold fact_cases')
		formatString: #,##0
		displayFolder: Portfolio Reliability
		lineageTag: e9e60f78-7139-40ea-a48d-9f31481e41bd

	/// Number of distinct procedures represented in the case-level fact table. Matches gold procedure_baseline's row count (418), confirming full join coverage with no unmatched procedure keys.
	measure 'Distinct Procedures' = DISTINCTCOUNT('gold fact_cases'[procedure_nm])
		formatString: #,##0
		displayFolder: Portfolio Reliability
		lineageTag: e71cd38b-ac01-4ba4-b248-b8c9e4b3d5fb

	/// Average absolute deviation, in minutes, between actual OR duration and the procedure's historical median baseline. Computed directly across all cases, not as an average of per-procedure MAE values.
	measure 'Mean Absolute Error (min)' = AVERAGE('gold fact_cases'[abs_error_min])
		formatString: #,##0.0
		displayFolder: Portfolio Reliability
		lineageTag: bd898a8f-3cd8-4708-967b-f4a723c72d9c

	/// Median absolute deviation, in minutes, between actual OR duration and the procedure's historical median baseline. Computed directly across all cases, not as an average of per-procedure medians.
	measure 'Median Absolute Error (min)' = MEDIAN('gold fact_cases'[abs_error_min])
		formatString: #,##0.0
		displayFolder: Portfolio Reliability
		lineageTag: 59078d43-1d1c-4b14-b203-47393f819415

	/// Sum of case-level absolute deviation minutes across the full historical cohort. Basis for the annualized exposure estimates below.
	measure 'Total Absolute Deviation (min)' = SUM('gold fact_cases'[abs_error_min])
		formatString: #,##0
		displayFolder: Cost Exposure
		lineageTag: ad617479-71a2-4524-82b7-6e80275d02e5

	/// Total absolute deviation minutes normalized to an annual rate, dividing by the 5.75 years of source data covered by the cohort.
	measure 'Annualized Absolute Deviation (min)' = DIVIDE([Total Absolute Deviation (min)], 5.75)
		formatString: #,##0
		displayFolder: Cost Exposure
		lineageTag: f0722418-0a07-49ad-9448-7acf671e4b85

	/// Scenario estimate of annualized gross cost exposure from schedule deviation, assuming $35 of OR-time value per minute. A gross scenario estimate, not a projection of recoverable savings.
	measure 'Annualized Gross Exposure @ $35/min' = [Annualized Absolute Deviation (min)] * 35
		formatString: $#,##0
		displayFolder: Cost Exposure
		lineageTag: 59a0496f-3395-441d-8733-e14acae05b65

	/// Scenario estimate of annualized gross cost exposure from schedule deviation, assuming $60 of OR-time value per minute. A gross scenario estimate, not a projection of recoverable savings.
	measure 'Annualized Gross Exposure @ $60/min' = [Annualized Absolute Deviation (min)] * 60
		formatString: $#,##0
		displayFolder: Cost Exposure
		lineageTag: 09d524d6-5d49-404e-870a-fcf0434193a7

	/// Static footer caption text for the report canvas — the two durable definitional caveats only (benchmark definition + gross-exposure caveat). Interaction hints live next to their own controls instead (e.g. the timing-outcome chart's own title) so this stays short enough to render on one line. A textbox visual with this content silently failed to render in this Desktop build; a card visual bound to a text measure is the reliable fallback confirmed working throughout this session.
	measure 'Footer Note' = "Benchmark = each procedure's own historical median duration, not a scheduled time  ·  Exposure figures are gross scenario estimates, not confirmed savings."
		displayFolder: Portfolio Reliability
		lineageTag: 5db5ede6-2294-44e8-a1f9-5e729e3d5028

	/// Static report title text (main headline), rendered via a card visual — textbox visuals do not render in this Desktop build.
	measure 'Title Main' = "OR Scheduling Reliability & Cost Exposure"
		displayFolder: Portfolio Reliability
		lineageTag: 6d07a3d5-61ca-40fc-b7c4-14fe51c7fc94

	/// Static report title text (subhead), rendered via a card visual — textbox visuals do not render in this Desktop build.
	measure 'Title Sub' = "See how often procedure times vary, what that variation represents in cost, and where to review first."
		displayFolder: Portfolio Reliability
		lineageTag: f971a469-5f88-4896-a9d5-178d78b93868

	/// Share of cases in the current Timing Outcome bucket, as a percentage of whatever cohort is currently in view. Removes only the Timing Outcome bucket's own filter (not any active procedure/Review Focus/search selection), so the denominator reflects the full cohort in view without the per-bucket narrowing a bidirectional relationship would otherwise introduce. Kept for tooltip use; the timing-outcome chart itself now gets its percentages natively from the 100% Stacked Bar Chart's own stacking calculation, bound to Total Cases, rather than from this measure.
	measure '% of Cases (Timing Outcome)' =
			VAR CurrentCount = COUNTROWS('gold fact_cases')
			VAR TotalCount = CALCULATE(COUNTROWS('gold fact_cases'), REMOVEFILTERS('gold fact_cases'[Timing Outcome]))
			RETURN DIVIDE(CurrentCount, TotalCount)
		formatString: 0.0%
		displayFolder: Portfolio Reliability
		lineageTag: f327ab77-eed2-4c4a-8dc4-ffe3587b7dd4

