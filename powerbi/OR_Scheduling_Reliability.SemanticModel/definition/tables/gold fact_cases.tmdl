	column early_30
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 62f04153-8d51-4c7a-a1a8-32e04ca6b98d
		summarizeBy: none
		sourceColumn: early_30

		annotation SummarizationSetBy = Automatic

	/// Disjoint, click-to-filter timing category for each case, evaluated in a fixed order so every case lands in exactly one bucket (a >60-min-late case is never also counted as >30-min-late): Late by more than 60 min, Late by 30-60 min, Early by more than 30 min, or Within 30 min either way. Drives the interactive timing-outcome bar chart; selecting a bucket filters the scatter, table, and portfolio cards via the case-to-procedure relationship.
	column 'Timing Outcome' =
			SWITCH(
			    TRUE(),
			    'gold fact_cases'[overrun_60] = TRUE(), "Late by more than 60 min",
			    'gold fact_cases'[overrun_30] = TRUE(), "Late by 30-60 min",
			    'gold fact_cases'[early_30] = TRUE(), "Early by more than 30 min",
			    "Within 30 min either way"
			)
		lineageTag: ddb8fd1c-7f4e-484e-a408-b5e03f8b49a7
		summarizeBy: none
		sortByColumn: 'Timing Outcome Sort'

		annotation SummarizationSetBy = Automatic

	/// Hidden sort key for Timing Outcome, ordering buckets from earliest to latest (1=Early, 2=Within, 3=Late 30-60, 4=Late 60+) instead of alphabetically. Mirrors Timing Outcome's own branch order so every case sorts consistently with its category.
	column 'Timing Outcome Sort' =
			SWITCH(
			    TRUE(),
			    'gold fact_cases'[overrun_60] = TRUE(), 4,
			    'gold fact_cases'[overrun_30] = TRUE(), 3,
			    'gold fact_cases'[early_30] = TRUE(), 1,
			    2
			)
		isHidden
		formatString: 0
		lineageTag: 0aad9279-c977-4c86-ab49-4d1e3fdaf3d0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Constant label used only as the (required) Category/axis field for the timing-outcome 100% Stacked Bar Chart, so all cases collapse into a single bar segmented by Timing Outcome (via Series) instead of one bar per bucket.
	column Cohort = "All Cases"
		dataType: string
		lineageTag: c2e6a319-4b6a-4b3a-9b1a-2f7a6c8d9e10
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'gold fact_cases' = m
		mode: import
		source =
				let
				    Source = Sql.Database("opu254nl33zulpqake74kewhge-2avfjyg5adkebmenf26ohq4cmq.datawarehouse.fabric.microsoft.com", "moverdata"),
				    gold_fact_cases = Source{[Schema="gold",Item="fact_cases"]}[Data]
				in
				    gold_fact_cases

	annotation PBI_ResultType = Table

